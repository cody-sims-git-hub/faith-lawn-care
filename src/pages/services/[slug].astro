---
import Layout from "~/layouts/Layout.astro";
import PageHeader from "~/components/PageHeader.astro";
import Section from "~/components/Section.astro";
import ServiceIcon from "~/components/ServiceIcon.astro";
import CtaBand from "~/components/CtaBand.astro";
import { Check, ArrowRight, MapPin } from "@lucide/astro";
import { services, type Service } from "~/lib/services";
import { areasByTier } from "~/lib/areas";
import { localBusiness, serviceSchema, breadcrumbs } from "~/lib/structured-data";

export function getStaticPaths() {
 return services.map((service) => ({
 params: { slug: service.slug },
 props: { service },
 }));
}

interface Props {
 service: Service;
}
const { service } = Astro.props;

// Related services: the next three in the catalogue, wrapping around. Keeps
// every detail page internally linked without hand-maintaining a graph.
const index = services.findIndex((s) => s.slug === service.slug);
const related = [1, 2, 3].map((offset) => services[(index + offset) % services.length]);

const coreAreas = areasByTier("core");

const jsonLd = [
 localBusiness(),
 serviceSchema(service),
 breadcrumbs([
 { name: "Home", path: "/" },
 { name: "Services", path: "/services" },
 { name: service.name, path: `/services/${service.slug}` },
 ]),
];
---

<Layout
 title={service.seoTitle}
 description={service.seoDescription}
 path={`/services/${service.slug}`}
 jsonLd={jsonLd}
>
 <PageHeader
 eyebrow="Service"
 title={service.heading ?? service.name}
 trail={[{ name: "Services", path: "/services" }]}
 >
 {service.summary}
 </PageHeader>

 <Section>
 <div class="grid gap-12 lg:grid-cols-[1.5fr_1fr] lg:gap-16">
 {/* ---- Body ---- */}
 <div>
 <div class="flex items-center gap-4" data-reveal>
 <span
 class="inline-flex h-14 w-14 items-center justify-center rounded-md bg-field-wash text-field-bright"
 >
 <ServiceIcon name={service.icon} class="h-7 w-7" />
 </span>
 <h2 class="font-display text-2xl text-ink">
 What you should know
 </h2>
 </div>

 <div class="mt-7 space-y-5" data-reveal-group>
 {
 service.body.map((paragraph) => (
 <p class="text-lg leading-relaxed text-ink-soft" data-reveal="fade">
 {paragraph}
 </p>
 ))
 }
 </div>

 <h2 class="mt-14 font-display text-2xl text-ink" data-reveal>
 Where we do it
 </h2>
 <p class="mt-3 text-lg leading-relaxed text-ink-soft" data-reveal>
 {service.name} is available across our whole service area — Jackson
 County weekly, Calhoun and Liberty on scheduled routes, and further out
 for larger jobs.
 </p>
 <ul class="mt-5 flex flex-wrap gap-2" data-reveal>
 {
 coreAreas.map((area) => (
 <li
 class="inline-flex items-center gap-1.5 rounded-full border border-rule px-3 py-1.5 text-sm text-ink-soft"
 >
 <MapPin class="h-3.5 w-3.5 text-field" aria-hidden="true" />
 {area.name}
 </li>
 ))
 }
 </ul>
 <a
 href="/service-areas"
 class="mt-5 inline-flex items-center gap-1.5 text-base font-bold text-field hover:underline"
 data-reveal
 >
 See the full coverage map
 <ArrowRight class="h-4 w-4" aria-hidden="true" />
 </a>
 </div>

 {/* ---- Sidebar: what's included ---- */}
 <aside class="lg:sticky lg:top-24 lg:self-start">
 <div class="card rounded-md p-6" data-reveal="right">
 <h2 class="font-display text-xl text-ink">
 What&rsquo;s included
 </h2>
 <ul class="mt-5 space-y-3">
 {
 service.includes.map((item) => (
 <li class="flex items-start gap-2.5">
 <Check class="mt-0.5 h-5 w-5 shrink-0 text-field" aria-hidden="true" />
 <span class="text-sm leading-relaxed text-ink-soft">{item}</span>
 </li>
 ))
 }
 </ul>

 <a
 href="/contact"
 class="mt-7 flex items-center justify-center gap-2 rounded-sm bg-field px-5 py-3.5 text-base font-bold text-white transition-colors hover:bg-field-deep"
 >
 Get a free estimate
 </a>
 </div>
 </aside>
 </div>
 </Section>

 {/* ---- Related ---- */}
 <Section band size="sm">
 <h2 class="font-display text-2xl text-ink" data-reveal>
 Often booked together
 </h2>
 <div class="mt-7 grid gap-4 sm:grid-cols-3" data-reveal-group>
 {
 related.map((item) => (
 <a
 href={`/services/${item.slug}`}
 class="card group flex items-center gap-4 rounded-md p-5 transition-colors hover:border-field/50"
 data-reveal
 >
 <span
 class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-sm bg-field-wash text-field-bright"
 >
 <ServiceIcon name={item.icon} class="h-5 w-5" />
 </span>
 <span class="flex-1 font-display text-base leading-tight text-ink">
 {item.name}
 </span>
 <ArrowRight
 class="h-4 w-4 shrink-0 text-field transition-transform group-hover:translate-x-1"
 aria-hidden="true"
 />
 </a>
 ))
 }
 </div>
 </Section>

 <CtaBand />
</Layout>
