---
import Layout from "~/layouts/Layout.astro";
import PageHeader from "~/components/PageHeader.astro";
import Section from "~/components/Section.astro";
import QuoteForm from "~/components/QuoteForm.astro";
import FacebookIcon from "~/components/FacebookIcon.astro";
import { Phone, MessageSquare, Clock, MapPin } from "@lucide/astro";
import {
 PHONE_DISPLAY,
 TEL_HREF,
 SMS_HREF,
 FACEBOOK_URL,
 HOURS,
 BASE_CITY,
 BASE_STATE_CODE,
} from "~/lib/site-meta";
import { localBusiness, breadcrumbs } from "~/lib/structured-data";

const jsonLd = [
 localBusiness(),
 breadcrumbs([
 { name: "Home", path: "/" },
 { name: "Contact", path: "/contact" },
 ]),
];
---

<Layout
 title="Contact Faith Lawn Care | Free Estimates in Marianna, FL"
 description="Call or text 850-209-8982 for a free lawn care, landscaping, or junk removal estimate in Marianna and across Jackson, Calhoun, and Liberty counties."
 path="/contact"
 jsonLd={jsonLd}
>
 <PageHeader eyebrow="Get in touch" title="Free Estimates">
 Calling is fastest, and you can text us a photo of the yard if that is
 easier. If you would rather type it out, the form works too.
 </PageHeader>

 <Section>
 <div class="grid gap-12 lg:grid-cols-[1fr_1.3fr] lg:gap-16">
 {/* ---- Direct contact ---- */}
 <div>
 <h2 class="font-display text-2xl text-ink" data-reveal>
 Reach us directly
 </h2>

 <div class="mt-6 space-y-3" data-reveal-group>
 <a
 href={TEL_HREF}
 data-track="contact-call"
 class="card flex items-center gap-4 rounded-md p-5 transition-colors hover:border-grass"
 data-reveal
 >
 <span
 class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-sm bg-forest text-white"
 >
 <Phone class="h-5 w-5" aria-hidden="true" />
 </span>
 <span>
 <span class="block text-xs font-semibold uppercase tracking-wider text-ink-soft">
 Call
 </span>
 <span class="block text-xl font-bold text-ink">{PHONE_DISPLAY}</span>
 </span>
 </a>

 <a
 href={SMS_HREF}
 data-track="contact-text"
 class="card flex items-center gap-4 rounded-md p-5 transition-colors hover:border-grass"
 data-reveal
 >
 <span
 class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-sm bg-paper-sunk text-grass-lit"
 >
 <MessageSquare class="h-5 w-5" aria-hidden="true" />
 </span>
 <span>
 <span class="block text-xs font-semibold uppercase tracking-wider text-ink-soft">
 Text
 </span>
 <span class="block text-xl font-bold text-ink">{PHONE_DISPLAY}</span>
 </span>
 </a>

 <a
 href={FACEBOOK_URL}
 target="_blank"
 rel="noopener noreferrer"
 class="card flex items-center gap-4 rounded-md p-5 transition-colors hover:border-grass"
 data-reveal
 >
 <span
 class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-sm bg-paper-sunk text-grass-lit"
 >
 <FacebookIcon class="h-5 w-5" />
 </span>
 <span>
 <span class="block text-xs font-semibold uppercase tracking-wider text-ink-soft">
 Facebook
 </span>
 <span class="block text-lg font-bold text-ink">See recent work</span>
 </span>
 </a>
 </div>

 <div class="card mt-6 rounded-md p-6" data-reveal>
 <h3 class="flex items-center gap-2 font-display text-lg text-ink">
 <Clock class="h-5 w-5 text-grass" aria-hidden="true" />
 Hours
 </h3>
 <ul class="mt-4 space-y-2">
 {
 HOURS.map((h) => (
 <li class="flex justify-between gap-4 text-sm">
 <span class="text-ink-soft">{h.days}</span>
 <span class="font-semibold text-ink">
 {h.close ? `${h.open} – ${h.close}` : h.open}
 </span>
 </li>
 ))
 }
 </ul>
 <p
 class="mt-5 flex items-start gap-2 border-t border-rule pt-4 text-sm text-ink-soft"
 >
 <MapPin class="mt-0.5 h-4 w-4 shrink-0 text-grass" aria-hidden="true" />
 Based in {BASE_CITY}, {BASE_STATE_CODE}. We are a mobile service — there
 is no shop to visit, we come to the property.
 </p>
 </div>
 </div>

 {/* ---- Form ---- */}
 <div id="estimate" data-reveal="right">
 <h2 class="font-display text-2xl text-ink">
 Request an estimate
 </h2>
 <p class="mt-3 text-base leading-relaxed text-ink-soft">
 Tell us a bit about the property and we will get back to you — usually
 the same day.
 </p>
 <div class="mt-6">
 <QuoteForm />
 </div>
 </div>
 </div>
 </Section>
</Layout>
