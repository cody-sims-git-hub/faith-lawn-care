---
import Layout from "~/layouts/Layout.astro";
import PageHeader from "~/components/PageHeader.astro";
import Section from "~/components/Section.astro";
import QuoteForm from "~/components/QuoteForm.astro";
import FacebookIcon from "~/components/FacebookIcon.astro";
import { Phone, MessageSquare, Clock, MapPin } from "@lucide/astro";
import {
  PHONE_DISPLAY,
  TEL_HREF,
  SMS_HREF,
  FACEBOOK_URL,
  HOURS,
  BASE_CITY,
  BASE_STATE_CODE,
} from "~/lib/site-meta";
import { localBusiness, breadcrumbs } from "~/lib/structured-data";

const jsonLd = [
  localBusiness(),
  breadcrumbs([
    { name: "Home", path: "/" },
    { name: "Contact", path: "/contact" },
  ]),
];
---

<Layout
  title="Contact Faith Lawn Care | Free Estimates in Marianna, FL"
  description="Call or text 850-209-8982 for a free lawn care, landscaping, or junk removal estimate in Marianna and across Jackson, Calhoun, and Liberty counties."
  path="/contact"
  jsonLd={jsonLd}
>
  <PageHeader eyebrow="Get in touch" title="Free Estimates">
    Calling is fastest, and you can text us a photo of the yard if that is
    easier. If you would rather type it out, the form works too.
  </PageHeader>

  <Section>
    <div class="grid gap-12 lg:grid-cols-[1fr_1.3fr] lg:gap-16">
      {/* ---- Direct contact ---- */}
      <div>
        <h2 class="font-display text-2xl font-bold uppercase text-foreground" data-reveal>
          Reach us directly
        </h2>

        <div class="mt-6 space-y-3" data-reveal-group>
          <a
            href={TEL_HREF}
            data-track="contact-call"
            class="panel flex items-center gap-4 rounded-xl p-5 transition-colors hover:border-primary/50"
            data-reveal
          >
            <span
              class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-primary text-primary-foreground"
            >
              <Phone class="h-5 w-5" aria-hidden="true" />
            </span>
            <span>
              <span class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                Call
              </span>
              <span class="block text-xl font-bold text-foreground">{PHONE_DISPLAY}</span>
            </span>
          </a>

          <a
            href={SMS_HREF}
            data-track="contact-text"
            class="panel flex items-center gap-4 rounded-xl p-5 transition-colors hover:border-primary/50"
            data-reveal
          >
            <span
              class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-primary/12 text-primary ring-1 ring-primary/25"
            >
              <MessageSquare class="h-5 w-5" aria-hidden="true" />
            </span>
            <span>
              <span class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                Text
              </span>
              <span class="block text-xl font-bold text-foreground">{PHONE_DISPLAY}</span>
            </span>
          </a>

          <a
            href={FACEBOOK_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="panel flex items-center gap-4 rounded-xl p-5 transition-colors hover:border-primary/50"
            data-reveal
          >
            <span
              class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-primary/12 text-primary ring-1 ring-primary/25"
            >
              <FacebookIcon class="h-5 w-5" />
            </span>
            <span>
              <span class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                Facebook
              </span>
              <span class="block text-lg font-bold text-foreground">See recent work</span>
            </span>
          </a>
        </div>

        <div class="panel mt-6 rounded-xl p-6" data-reveal>
          <h3 class="flex items-center gap-2 font-display text-lg font-bold uppercase text-foreground">
            <Clock class="h-5 w-5 text-primary" aria-hidden="true" />
            Hours
          </h3>
          <ul class="mt-4 space-y-2">
            {
              HOURS.map((h) => (
                <li class="flex justify-between gap-4 text-sm">
                  <span class="text-muted-foreground">{h.days}</span>
                  <span class="font-semibold text-foreground">
                    {h.close ? `${h.open} – ${h.close}` : h.open}
                  </span>
                </li>
              ))
            }
          </ul>
          <p
            class="mt-5 flex items-start gap-2 border-t border-border/60 pt-4 text-sm text-muted-foreground"
          >
            <MapPin class="mt-0.5 h-4 w-4 shrink-0 text-primary" aria-hidden="true" />
            Based in {BASE_CITY}, {BASE_STATE_CODE}. We are a mobile service — there
            is no shop to visit, we come to the property.
          </p>
        </div>
      </div>

      {/* ---- Form ---- */}
      <div id="estimate" data-reveal="right">
        <h2 class="font-display text-2xl font-bold uppercase text-foreground">
          Request an estimate
        </h2>
        <p class="mt-3 text-base leading-relaxed text-muted-foreground">
          Tell us a bit about the property and we will get back to you — usually
          the same day.
        </p>
        <div class="mt-6">
          <QuoteForm />
        </div>
      </div>
    </div>
  </Section>
</Layout>
