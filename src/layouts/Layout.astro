---
import "~/styles/global.css";
import {
  SITE_URL,
  SITE_NAME,
  OG_IMAGE,
  SITE_HOST,
  GA_MEASUREMENT_ID,
} from "~/lib/site-meta";
import SiteHeader from "~/components/SiteHeader.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import CallBar from "~/components/CallBar.astro";
import TopBar from "~/components/TopBar.astro";
import QuotePopup from "~/components/QuotePopup.astro";

interface Props {
 title: string;
 description: string;
 path?: string;
 /** Root-relative social image; defaults to the site-wide OG image. */
 ogImage?: string;
 /** schema.org JSON-LD objects rendered into <head>. */
 jsonLd?: unknown[];
 /**
  * Responsive image to preload as the LCP element (the homepage hero).
  * Emitting this in <head> lets the browser fetch the hero concurrently with
  * the CSS instead of waiting until it parses the <img> in the body — which
  * was costing ~635ms of LCP "load delay" on mobile.
  */
 preloadImage?: { imagesrcset: string; imagesizes: string };
}

const {
 title,
 description,
 path = "/",
 ogImage,
 jsonLd = [],
 preloadImage,
} = Astro.props;

// Canonical carries no trailing slash (see astro.config.mjs). The root is the
// one exception — "https://site.com" with nothing after it.
const canonical = SITE_URL + (path === "/" ? "" : path);
const ogImageUrl = ogImage
 ? ogImage.startsWith("http")
 ? ogImage
 : SITE_URL + ogImage
 : OG_IMAGE;
---

<!doctype html>
<html lang="en">
 <head>
 <meta charset="utf-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1" />
 <meta name="theme-color" content="#1b7f3d" />
 <meta name="color-scheme" content="light" />

 {/* Mark JS as available before first paint so reveal elements start hidden
 with no flash. Without JS they stay visible (see global.css). */}
 <script is:inline>
 document.documentElement.classList.add("js");
 </script>

 <title>{title}</title>
 <meta name="description" content={description} />
 <link rel="canonical" href={canonical} />

 {/* LCP hero preload — fetches the hero image alongside the CSS. */}
 {
 preloadImage && (
 <link
 rel="preload"
 as="image"
 imagesrcset={preloadImage.imagesrcset}
 imagesizes={preloadImage.imagesizes}
 fetchpriority="high"
 />
 )
 }

 {/* Open Graph */}
 <meta property="og:type" content="website" />
 <meta property="og:site_name" content={SITE_NAME} />
 <meta property="og:title" content={title} />
 <meta property="og:description" content={description} />
 <meta property="og:url" content={canonical} />
 <meta property="og:image" content={ogImageUrl} />
 <meta property="og:image:width" content="1200" />
 <meta property="og:image:height" content="630" />
 <meta property="og:image:alt" content={SITE_NAME} />
 <meta property="og:locale" content="en_US" />

 {/* Twitter */}
 <meta name="twitter:card" content="summary_large_image" />
 <meta name="twitter:title" content={title} />
 <meta name="twitter:description" content={description} />
 <meta name="twitter:image" content={ogImageUrl} />

 {/* Icons */}
 <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
 <link rel="apple-touch-icon" href="/icon-180.png" />

 {/* Fonts load async so the third-party stylesheet never blocks first paint.
 Text renders immediately in the system fallback and swaps when it
 arrives — see --font-sans / --font-display in global.css. */}
 <link rel="preconnect" href="https://fonts.googleapis.com" />
 <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
 <link
 rel="stylesheet"
 href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;600;800&display=swap"
 media="print"
 onload="this.media='all'"
 />
 <noscript>
 <link
 rel="stylesheet"
 href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;600;800&display=swap"
 />
 </noscript>

 {
 jsonLd.map((obj) => (
 <script type="application/ld+json" is:inline set:html={JSON.stringify(obj)} />
 ))
 }
 </head>
 <body>
 <a
 href="#main"
 class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-sm focus:bg-forest focus:px-4 focus:py-2 focus:font-semibold focus:text-white"
 >
 Skip to content
 </a>

 <div class="relative flex min-h-svh flex-col">
 <TopBar />
      <SiteHeader />
 <main id="main" class="flex-1">
 <slot />
 </main>
 <SiteFooter />
 <CallBar />
      <QuotePopup />
 </div>

 <script>
 import { initReveal } from "~/lib/reveal";

 if (document.readyState === "loading") {
 document.addEventListener("DOMContentLoaded", () => initReveal(), { once: true });
 } else {
 initReveal();
 }
 </script>
 
  <!--
    Google Analytics — loaded LAZILY, off the critical path.

    gtag.js costs ~127ms of main-thread time. Loading it during page load pushed
    Total Blocking Time up and dragged the mobile PageSpeed score down even
    though LCP and CLS were already green. So we defer it until the first real
    signal of engagement — the first interaction, or ~4s of idle, whichever
    comes first — which keeps the initial load's main thread clear while still
    capturing every genuine visit (the pageview fires the moment gtag loads).

    Gated on the canonical hostname on purpose: Cloudflare Pages serves every
    branch preview on a public *.pages.dev URL, and without this gate our own
    previews — and any crawler that finds them — report as real visits. If a
    staging domain is added later, add it here or it will record nothing.

    googletagmanager.com and google-analytics.com must stay listed in the CSP in
    public/_headers, or this loads nothing and fails silently.
  -->
  <script is:inline define:vars={{ gaId: GA_MEASUREMENT_ID, siteHost: SITE_HOST }}>
    if (window.location.hostname === siteHost) {
      var started = false;
      var load = function () {
        if (started) return;
        started = true;
        var tag = document.createElement("script");
        tag.async = true;
        tag.src = "https://www.googletagmanager.com/gtag/js?id=" + gaId;
        document.head.appendChild(tag);

        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }
        window.gtag = gtag;
        gtag("js", new Date());
        gtag("config", gaId);
      };

      var events = ["scroll", "pointerdown", "keydown", "touchstart"];
      var kick = function () {
        events.forEach(function (e) {
          window.removeEventListener(e, kick, { passive: true });
        });
        load();
      };
      events.forEach(function (e) {
        window.addEventListener(e, kick, { passive: true, once: true });
      });

      // Fallback so a visitor who never interacts is still counted.
      if ("requestIdleCallback" in window) {
        requestIdleCallback(load, { timeout: 4000 });
      } else {
        setTimeout(load, 4000);
      }
    }
  </script>
</body>
</html>
