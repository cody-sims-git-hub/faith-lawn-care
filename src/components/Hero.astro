---
/**
 * Homepage hero.
 *
 * A plain statement of what they do, the phone number as the primary action,
 * and a photograph of their own work at a generous size. The photo is the
 * proof, so it gets to be a photograph — no scrim, no overlay text.
 *
 * The h1 uses animate-rise rather than a fade: Chrome will not nominate text as
 * an LCP candidate while it is opacity:0, so fading it would charge the entire
 * animation duration to the LCP measurement.
 */
import { Image } from "astro:assets";
import { Phone, MessageSquare, Check } from "@lucide/astro";
import heroImage from "~/assets/hero-lawn.jpg";
import { PHONE_DISPLAY, TEL_HREF, SMS_HREF } from "~/lib/site-meta";

const proofPoints = ["Free estimates", "No contracts", "We haul it all off"];
---

<section class="border-b border-rule">
 <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:py-24">
 <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
 {/* ---- Statement ---- */}
 <div class="lg:col-span-6">
 <p class="pill">Serving Jackson, Calhoun &amp; Liberty counties</p>

 <h1 class="animate-rise mt-5 text-[2.6rem] text-ink sm:text-6xl">
 Your yard, <span class="text-field">handled.</span>
 </h1>

 <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">
 Mowing, landscaping, tree work, pressure washing, and junk hauling —
 one crew for the whole property. We show up when we say we will, and
 nothing gets left at the curb.
 </p>

 <ul class="mt-7 flex flex-wrap gap-x-6 gap-y-2.5">
 {
 proofPoints.map((point) => (
 <li class="flex items-center gap-2 text-sm font-bold text-field-deep">
 <Check class="h-4.5 w-4.5 shrink-0 text-field-bright" aria-hidden="true" />
 {point}
 </li>
 ))
 }
 </ul>

 <div class="mt-9 flex flex-col gap-3 sm:flex-row">
 <a
 href={TEL_HREF}
 data-track="hero-call"
 class="inline-flex items-center justify-center gap-2.5 rounded-sm bg-field px-7 py-4 text-base font-extrabold text-white transition-colors hover:bg-field-deep"
 >
 <Phone class="h-5 w-5" aria-hidden="true" />
 Call {PHONE_DISPLAY}
 </a>
 <a
 href={SMS_HREF}
 data-track="hero-text"
 class="inline-flex items-center justify-center gap-2.5 rounded-sm bg-paper-sunk px-7 py-4 text-base font-extrabold text-field-deep transition-colors hover:bg-field-wash"
 >
 <MessageSquare class="h-5 w-5" aria-hidden="true" />
 Text us a photo
 </a>
 </div>

 <p class="mt-5 text-sm text-ink-soft">
 Or <a
 href="/contact"
 class="font-bold text-field underline underline-offset-2">request an estimate online</a
 > — we usually reply the same day.
 </p>
 </div>

 {/* ---- The photograph ---- */}
 <div class="lg:col-span-6" data-reveal="right">
 {/*
 width/height are explicit on purpose: without them Astro points the
 `src` fallback at the full 3051px original — a ~900kB LCP image for
 any client that ignores srcset. They also fix the intrinsic aspect
 ratio, so this contributes no CLS.
 */}
 <Image
 src={heroImage}
 alt="A wide Jackson County property freshly cut by Faith Lawn Care, with clean mowing stripes running the length of the yard toward the treeline"
 widths={[640, 960, 1280, 1600]}
 sizes="(min-width: 1024px) 50vw, 92vw"
 width={1600}
 height={900}
 quality={68}
 loading="eager"
 fetchpriority="high"
 class="w-full rounded-lg object-cover"
 />
 </div>
 </div>
 </div>
</section>
