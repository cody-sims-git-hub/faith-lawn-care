---
import { Phone, Menu, X } from "@lucide/astro";
import Logo from "./Logo.astro";
import { PHONE_DISPLAY, TEL_HREF } from "~/lib/site-meta";

const nav = [
 { label: "Services", href: "/services" },
 { label: "Service Areas", href: "/service-areas" },
 { label: "Gallery", href: "/gallery" },
 { label: "About", href: "/about" },
 { label: "Contact", href: "/contact" },
];

// Astro.url.pathname carries no trailing slash (trailingSlash: 'never').
const current = Astro.url.pathname;
const isActive = (href: string) =>
 href === "/" ? current === "/" : current === href || current.startsWith(`${href}/`);
---

<header
 class="sticky top-0 z-50 border-b border-rule bg-paper"
 x-data="{ open: false }"
>
 <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
 <a href="/" class="shrink-0" aria-label="Faith Lawn Care — home">
 <Logo compact />
 </a>

 <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
 {
 nav.map((item) => (
 <a
 href={item.href}
 aria-current={isActive(item.href) ? "page" : undefined}
 class:list={[
 "rounded-md px-3 py-2 text-sm font-semibold transition-colors",
 isActive(item.href)
 ? "text-field"
 : "text-ink-soft hover:text-ink",
 ]}
 >
 {item.label}
 </a>
 ))
 }
 </nav>

 <div class="flex items-center gap-2">
 <a
 href={TEL_HREF}
 data-track="header-call"
 class="hidden items-center gap-2 rounded-sm bg-field px-4 py-2.5 text-sm font-bold text-white transition-colors hover:bg-field-deep sm:inline-flex"
 >
 <Phone class="h-4 w-4" aria-hidden="true" />
 {PHONE_DISPLAY}
 </a>

 <button
 type="button"
 class="inline-flex items-center justify-center rounded-sm border border-rule p-2.5 text-ink lg:hidden"
 x-on:click="open = !open"
 x-bind:aria-expanded="open ? 'true' : 'false'"
 aria-controls="mobile-nav"
 aria-label="Toggle menu"
 >
 <X class="h-5 w-5" x-show="open" x-cloak aria-hidden="true" />
 <Menu class="h-5 w-5" x-show="!open" aria-hidden="true" />
 </button>
 </div>
 </div>

 <div
 id="mobile-nav"
 class="border-t border-rule lg:hidden"
 x-show="open"
 x-cloak
 x-transition.origin.top
 >
 <nav class="mx-auto max-w-7xl px-4 py-3 sm:px-6" aria-label="Mobile">
 <ul class="flex flex-col">
 {
 nav.map((item) => (
 <li>
 <a
 href={item.href}
 aria-current={isActive(item.href) ? "page" : undefined}
 class:list={[
 "block rounded-md px-3 py-3 text-base font-semibold",
 isActive(item.href) ? "text-field" : "text-ink",
 ]}
 x-on:click="open = false"
 >
 {item.label}
 </a>
 </li>
 ))
 }
 </ul>
 <a
 href={TEL_HREF}
 data-track="mobile-nav-call"
 class="mt-2 flex items-center justify-center gap-2 rounded-sm bg-field px-4 py-3 text-base font-bold text-white sm:hidden"
 >
 <Phone class="h-5 w-5" aria-hidden="true" />
 Call {PHONE_DISPLAY}
 </a>
 </nav>
 </div>
</header>
