---
import { ArrowRight } from "@lucide/astro";
import ServiceIcon from "./ServiceIcon.astro";
import type { Service } from "~/lib/services";

interface Props {
  service: Service;
}
const { service } = Astro.props;
---

<a
  href={`/services/${service.slug}`}
  data-reveal
  data-tilt="6"
  class="tilt-card panel group relative flex flex-col overflow-hidden rounded-xl p-6 hover:border-primary/50"
>
  {/* Pointer-tracked sheen. Sits under the content, above the panel fill. */}
  <span
    class="tilt-sheen pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
    aria-hidden="true"></span>

  <span class="tilt-layer relative flex flex-1 flex-col" style="--tilt-z: 22px">
    <span
      class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-lg bg-primary/12 text-primary ring-1 ring-primary/25"
    >
      <ServiceIcon name={service.icon} class="h-6 w-6" />
    </span>

    <h3 class="text-xl font-bold uppercase leading-tight text-foreground">
      {service.name}
    </h3>

    <p class="mt-3 flex-1 text-sm leading-relaxed text-muted-foreground">
      {service.blurb}
    </p>

    <span
      class="mt-5 inline-flex items-center gap-1.5 text-sm font-bold text-primary"
    >
      Learn more
      <ArrowRight
        class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
        aria-hidden="true"
      />
    </span>
  </span>
</a>
