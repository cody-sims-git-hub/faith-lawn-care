---
import { ArrowRight } from "@lucide/astro";
import ServiceIcon from "./ServiceIcon.astro";
import type { Service } from "~/lib/services";

interface Props {
 service: Service;
}
const { service } = Astro.props;
---

<a
 href={`/services/${service.slug}`}
 data-reveal
 
 class=" card group relative flex flex-col overflow-hidden rounded-md p-6 hover:border-field/50"
>
 {/* Pointer-tracked sheen. Sits under the content, above the card fill. */}
 <span
 class=" pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
 aria-hidden="true"></span>

 <span class="relative flex flex-1 flex-col">
 <span
 class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-sm bg-field-wash text-field-bright"
 >
 <ServiceIcon name={service.icon} class="h-6 w-6" />
 </span>

 <h3 class="text-xl font-bold leading-tight text-ink">
 {service.name}
 </h3>

 <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-soft">
 {service.blurb}
 </p>

 <span
 class="mt-5 inline-flex items-center gap-1.5 text-sm font-bold text-field"
 >
 Learn more
 <ArrowRight
 class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
 aria-hidden="true"
 />
 </span>
 </span>
</a>
