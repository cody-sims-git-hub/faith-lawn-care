---
/**
 * The wordmark. The grass tuft is drawn inline rather than loaded as an image
 * so it inherits currentColor, stays sharp at any size, and costs no request.
 * It mirrors the lime grass mark on the company's own flyer.
 */
interface Props {
  /** Compact drops the tagline line — used in the sticky header. */
  compact?: boolean;
  class?: string;
}
const { compact = false, class: className = "" } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg
    class="h-8 w-8 shrink-0 text-primary"
    viewBox="0 0 32 32"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M16 28c0-6.5-1.6-11.4-4.8-14.6"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
    />
    <path
      d="M16 28c0-7.8 1.3-13 4-15.6"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
    />
    <path
      d="M16 28c-2.4-4.6-5.4-7.6-9-9"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
      opacity="0.75"
    />
    <path
      d="M16 28c2.2-4.2 5-7 8.4-8.4"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
      opacity="0.75"
    />
    <path d="M4 28h24" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
  </svg>

  <span class="flex flex-col leading-none">
    <span class="font-display text-[1.6rem] font-bold uppercase tracking-wide text-foreground">
      Faith Lawn Care
    </span>
    {
      !compact && (
        <span class="mt-0.5 text-[0.66rem] font-semibold uppercase tracking-[0.18em] text-primary">
          Full Service &amp; Junk Removal
        </span>
      )
    }
  </span>
</span>
