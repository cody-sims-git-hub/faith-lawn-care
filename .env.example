# Public build-time config, baked into the client bundle.
# The Turnstile SITE key is public by design — it is not a secret.
# Leave it empty locally and the quote form renders without a CAPTCHA.
PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# The values below are NOT read from this file at build time.
# They belong in the Cloudflare Pages project's environment variables, where
# the Pages Function reads them at request time. They are listed here only so
# the full set is discoverable in one place.
#
#   RESEND_API_KEY        secret — Resend API key
#   TURNSTILE_SECRET_KEY  secret — pairs with PUBLIC_TURNSTILE_SITE_KEY
#   LEAD_TO_EMAIL         inbox that receives quote requests
#   LEAD_FROM_EMAIL       Resend-verified sender, e.g. website@faithlawncarellc.com
#
# For local testing of the Function, put them in .dev.vars (gitignored) and run
# `npx wrangler pages dev dist`.
# ---------------------------------------------------------------------------
